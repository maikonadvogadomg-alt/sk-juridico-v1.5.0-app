# SK Juridico IA v1.5.0 -- Variaveis de Ambiente
# Copie para .env e preencha com seus dados

# Banco de Dados (opcional — sem isso usa armazenamento em arquivo local)
# DATABASE_URL=postgresql://sk_user:sk_pass@localhost:5432/sk_juridico

# Modo totalmente local (sem PostgreSQL) — dados salvos em sk-juridico-local-data.json
LOCAL_MODE=1

# Seguranca
SESSION_SECRET=mude-para-um-valor-secreto-aleatorio-longo-32-chars

# Servidor
PORT=8080
NODE_ENV=production

# Electron (configurado automaticamente pelo executavel)
# ELECTRON_MODE=1
# ELECTRON_DATA_PATH=/caminho/para/dados

# Capacitor/EAS (opcional)
# CAPACITOR_SERVER_URL=https://seu-backend.com
# EXPO_TOKEN=seu-token-eas-aqui

# OBS: Chaves de IA (Gemini, OpenAI, Groq, etc.) sao configuradas
# pela interface em Configuracoes > Chaves de API
# e ficam salvas em sk-juridico-local-data.json ou no banco de dados
